#include "Servo.h"     // Library to control servo motor
#include <Stepper.h>   // Library to control stepper motor

// Number of steps for one full revolution (28BYJ-48 motor)
const int stepsPerRevolution = 2048;

// Initialize stepper motor with control pins
Stepper myStepper(stepsPerRevolution, 11, 9, 10, 8);

// Create servo object
Servo myservo;

// Pin definitions
int servoPin = 12;        // Servo signal pin
int buzzer = 3;           // Buzzer pin
int buttonPlayer1 = 6;    // Player 1 button
int buttonPlayer2 = 5;    // Player 2 button

// Score variables
int score1 = 0;
int score2 = 0;

// Timing variables for reaction measurement
unsigned long startTime;
unsigned long reactionTime1;
unsigned long reactionTime2;

// Track current stepper position (for resetting later)
int stepperPosition = 0;

// ==============================
// SETUP FUNCTION (runs once)
// ==============================
void setup() {
  Serial.begin(9600);             // Start serial communication (for debugging/output)

  myStepper.setSpeed(10);         // Set stepper speed (10 RPM)

  myservo.attach(servoPin);       // Attach servo to pin

  // Set button pins with internal pull-up resistors
  pinMode(buttonPlayer1, INPUT_PULLUP);
  pinMode(buttonPlayer2, INPUT_PULLUP);

  pinMode(buzzer, OUTPUT);        // Set buzzer as output

  randomSeed(analogRead(A0));     // Seed random generator (for unpredictable delays)

  myservo.write(90);              // Set servo to neutral (center position)

  Serial.println("GAME STARTS AUTOMATICALLY");
}

// ==============================
// MAIN LOOP (runs repeatedly)
// ==============================
void loop() {
  resetGame();    // Reset scores and positions
  playGame();     // Start the game
  delay(5000);    // Wait 5 seconds before restarting
}

// ==============================
// MAIN GAME FUNCTION
// ==============================
void playGame() {

  myservo.write(90);  // Ensure servo starts centered

  // Continue rounds until one player reaches 3 points
  while (score1 < 3 && score2 < 3) {

    Serial.println("NEW ROUND");

    // Generate random delay between 1–20 seconds
    int delayTime = random(1000, 20001);
    unsigned long waitStart = millis();

    bool falseStart = false;  // Tracks if someone pressed early

    // ==============================
    // WAIT PHASE (before buzzer)
    // ==============================
    while (millis() - waitStart < delayTime) {

      // Player 1 pressed too early
      if (digitalRead(buttonPlayer1) == LOW) {
        Serial.println("FALSE START P1 — point to P2");

        score2++;  // Award point to Player 2

        // Print updated scores
        Serial.print("Scores -> P1: "); Serial.print(score1);
        Serial.print(" | P2: "); Serial.println(score2);

        moveServo(2);      // Move servo to Player 2 side
        updateStepper(2);  // Move stepper toward Player 2

        delay(1500);       // Pause to show result

        falseStart = true;
        break;             // Exit WAIT phase
      }

      // Player 2 pressed too early
      if (digitalRead(buttonPlayer2) == LOW) {
        Serial.println("FALSE START P2 — point to P1");

        score1++;  // Award point to Player 1

        Serial.print("Scores -> P1: "); Serial.print(score1);
        Serial.print(" | P2: "); Serial.println(score2);

        moveServo(1);      // Move servo to Player 1 side
        updateStepper(1);  // Move stepper toward Player 1

        delay(1500);

        falseStart = true;
        break;
      }
    }

    // If false start happened → skip buzzer & reaction phase
    if (falseStart) {
      continue;
    }

    // ==============================
    // BUZZER SIGNAL (start reaction)
    // ==============================
    tone(buzzer, 1000);  // Play 1kHz sound
    delay(200);          // Duration of sound
    noTone(buzzer);      // Stop sound

    startTime = millis();  // Record start time

    bool p1Pressed = false;
    bool p2Pressed = false;

    // ==============================
    // REACTION PHASE
    // ==============================
    while (!p1Pressed || !p2Pressed) {

      // Detect Player 1 press
      if (!p1Pressed && digitalRead(buttonPlayer1) == LOW) {
        reactionTime1 = millis() - startTime;
        p1Pressed = true;
      }

      // Detect Player 2 press
      if (!p2Pressed && digitalRead(buttonPlayer2) == LOW) {
        reactionTime2 = millis() - startTime;
        p2Pressed = true;
      }
    }

    // ==============================
    // DETERMINE ROUND WINNER
    // ==============================
    if (reactionTime1 < reactionTime2) {

      score1++;
      Serial.print("P1 WINS round! Reaction: ");
      Serial.println(reactionTime1);

      moveServo(1);
      updateStepper(1);

    } else {

      score2++;
      Serial.print("P2 WINS round! Reaction: ");
      Serial.println(reactionTime2);

      moveServo(2);
      updateStepper(2);
    }
    // Print updated scores
    Serial.print("Scores -> P1: "); Serial.print(score1);
    Serial.print(" | P2: "); Serial.println(score2);

    delay(1500);
  }
  // FINAL WINNER
  if (score1 >= 3) {
    Serial.println("GAME WINNER: P1");
  } else {
    Serial.println("GAME WINNER: P2");
  }

  victorySpin();  // Celebrate with full spin
}
// MOVE SERVO TO WINNER SIDE
void moveServo(int player) {
  if (player == 1)
    myservo.write(0);     // Player 1 side
  else
    myservo.write(180);   // Player 2 side
}
// UPDATE STEPPER (tug-of-war)
void updateStepper(int player) {
  if (player == 1) {
    myStepper.step(50);       // Move forward
    stepperPosition += 50;
  } else {
    myStepper.step(-50);      // Move backward
    stepperPosition -= 50;
  }
}
void victorySpin() {
  myStepper.step(stepsPerRevolution);
}
void resetGame() {

  score1 = 0;
  score2 = 0;

  myStepper.step(-stepperPosition); // Return stepper to center position
  stepperPosition = 0;

  myservo.write(90);  // Reset servo to neutral
}
